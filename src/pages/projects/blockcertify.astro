---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: 'BlockCertify by Vishal Dhatrika',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'Home', href: '/' },
        { text: 'Projects', href: '/#projects' },
        { text: 'Testimonials', href: '/#testimonials' },
        { text: 'Blog', href: '/blog' },
        { text: 'GitHub', href: 'https://github.com/vishaldhatrika' },
      ]}
      actions={[
        {
          text: 'Hire me',
          href: '/about#contact',
        },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero Widget ******************* -->

  <Hero
    id="hero"
    title="BlockCertify"
    tagline="Blockchain Certificate Verification"
    actions={[
      {
        variant: 'primary',
        text: 'GitHub Repository',
        href: 'https://github.com/vishaldhatrika',
        icon: 'tabler:brand-github',
      },
      { text: 'Live Demo', href: '#', icon: 'tabler:external-link' },
    ]}
    image={{ src: '~/assets/images/p2-2-bc-logo.png', alt: 'BlockCertify Hero Image' }}
  >
    <Fragment slot="subtitle">
      A decentralized, immutable solution for verifying academic and professional credentials. Built on Ethereum, <span
        class="font-semibold text-accent">BlockCertify</span
      > ensures that certificates are tamper-proof and instantly verifiable globally.
    </Fragment>
  </Hero>

  <!-- Content Widget (Problem & Solution) **************** -->

  <Content
    id="overview"
    columns={3}
    items={[
      // {
      //   icon: 'tabler:shield-lock',
      //   callToAction: {
      //     target: '_blank',
      //     text: 'Security Protocol',
      //     href: '#',
      //   },
      // },
    ]}
    image={{
      src: '~/assets/images/p2-blockcertify.png',
      alt: 'BlockCertify Overview Image',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Technical Overview</h2>
      <p>
        The current centralized certificate verification systems are prone to fraud, administrative delays, and lack of
        transparency. <span class="font-semibold">BlockCertify</span> addresses these issues by leveraging blockchain's decentralization.
      </p>
      <br />
      <p>
        Each certificate issued is hashed and stored on the Ethereum blockchain as a unique transaction. This ensures
        that any attempt to alter the certificate will immediately invalidate the verification check.
      </p>
      <br />
      <p>
        Key technical focus: <span class="font-italic"
          >Data Integrity, Decentralized Identity, and Cryptographic Security.</span
        >
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget (Technical Architecture) ****************** -->

  <Steps
    id="architecture"
    title="Technical Architecture"
    items={[
      {
        title: 'Step 1: Certificate Issuance',
        description: `The educational institution uploads the certificate details. The data is hashed using SHA-256 for privacy and integrity.`,
        icon: 'tabler:file-plus',
      },
      {
        title: 'Step 2: Smart Contract Interaction',
        description: `The institution's authorized Ethereum wallet signs a transaction to the Smart Contract, storing the digital signature and hash of the certificate.`,
        icon: 'tabler:link',
      },
      {
        title: 'Step 3: Blockchain Confirmation',
        description: `The transaction is mined on the Ethereum mainnet/testnet, providing an immutable timestamp and proof of issuance.`,
        icon: 'tabler:check',
      },
      {
        title: 'Step 4: Verification Process',
        description: `Students or employers upload the certificate file. The system re-hashes it and compares it with the hash stored on the blockchain via Web3.js.`,
        icon: 'tabler:search',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Features3 Widget (Tech Stack) ************** -->

  <Features3
    title="Core Tech Stack"
    subtitle="The technologies and tools that power the decentralized verification."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: 'Solidity',
        description: 'Used for writing the smart contracts that handle certificate logic and verification rules.',
      },
      {
        title: 'Ethereum',
        description: 'The underlying blockchain network provides a decentralized, tamper-proof registry.',
      },
      {
        title: 'Web3.js',
        description: 'The interface for the frontend to communicate with the Ethereum blockchain via JSON-RPC.',
      },
      {
        title: 'React.js',
        description: 'Used for building a responsive and interactive user interface.',
      },
      {
        title: 'MetaMask',
        description: 'Integrated as the primary wallet for institutional signing and user interaction.',
      },
      {
        title: 'IPFS',
        description: 'Utilized for decentralized storage of larger certificate data (if applicable).',
      },
    ]}
  />

  <!-- Content Widget (Key Implementation Details) **************** -->

  <Content
    id="implementation"
    title="Key Implementation Details"
    subtitle="A deeper look into the codebase and technical decisions."
    isReversed
    items={[
      {
        title: 'Smart Contract Design:',
        description:
          'Gas-optimized Solidity contract using the Factory Pattern to manage multiple institutions and their respective certificate registries.',
      },
      {
        title: 'Web3 Integration:',
        description:
          'Implemented custom hooks for wallet connection, contract instance management, and real-time transaction tracking.',
      },
    ]}
    image={{
      src: '~/assets/images/p2-3-bc-flowchart.png',
      alt: 'Code Snippet / Implementation Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Technical Deep Dive</h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget (Challenges & Solutions) **************** -->

  <Content
    id="challenges"
    title="Challenges & Technical Solutions"
    isReversed
    items={[
      {
        title: 'Gas Optimization:',
        description:
          'Challenge: High transaction costs on Ethereum. Solution: Optimized smart contract logic by reducing state changes and using event-based data retrieval instead of storage where possible.',
      },
      {
        title: 'Identity Verification:',
        description:
          'Challenge: Ensuring only authorized institutions can issue certificates. Solution: Implemented a Role-Based Access Control (RBAC) system using OpenZeppelin’s AccessControl contracts.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1639322537228-f710d846310a?ixlib=rb-4.0.3&auto=format&fit=crop&w=1632&q=80',
      alt: 'Blockchain Network Visualization',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Overcoming Technical Hurdles</h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget (Research & Publication) **************** -->

  <Content
    id="research"
    title="Research & Academic Impact"
    subtitle="Contributing to the broader field of Decentralized Identity and Blockchain Security."
    items={[
      {
        title: 'Research Paper:',
        description:
          'Authored a technical whitepaper detailing the comparison between traditional hash-based verification and decentralized zk-SNARKs for privacy-preserving credentialing.',
      },
      {
        title: 'PhD Application Highlight:',
        description:
          'This project serves as a practical implementation for my research interests in Secure Distributed Systems and Blockchain Security protocols.',
      },
    ]}
    image={{
      src: '~/assets/images/p2-1-blockcertify-research.png',
      alt: 'Academic Research Image',
    }}
    callToAction={{
      target: '_blank',
      text: 'View Published Paper [ DOI : https://doi.org/10.1063/5.0277375]',
      icon: 'tabler:file-text',
      href: 'https://doi.org/10.1063/5.0277375',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Academic Foundation</h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Accclodes & Feedback"
    subtitle="Validation from examiners and project collaborators."
    testimonials={[
      {
        testimonial: `Patent Application has been filed and we invite the parties involved to invoke a request for examination. We are impressed by the innovative approach and technical depth of the project.`,
        name: ' Patent Officers ',
        job: 'Ministry of Commerce and Industry, Government of India',
        image: {
          src: 'https://images.unsplash.com/photo-1511367461989-f85a21fda167?q=80&w=3431&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
          alt: 'Person Image',
        },
      },
      {
        testimonial: `BlockCertify provided a seamless verification experience, significantly reducing the turnaround time for credential validation and is a good project worthy of first prize.`,
        name: 'Sunil Subramanyam Yadavalli, Voruganti Aravind',
        job: 'Information Data Systems - IDS',
        image: {
          src: 'https://images.unsplash.com/photo-1511367461989-f85a21fda167?q=80&w=3431&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
          alt: 'Person Image',
        },
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Discuss Collaboration"
    subtitle="Interested in technical deep-dives or research partnerships?"
    actions={[
      {
        variant: 'primary',
        text: 'Contact Me',
        href: '/about#contact',
      },
    ]}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Read blog posts"
    information={`Stories and insights from building, learning, and growing in tech and creativity.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
