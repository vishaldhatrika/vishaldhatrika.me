---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Header from '~/components/widgets/Header.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';

const metadata = {
  title: 'Vishal D - Portfolio',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget  -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Connect on LinkedIn',
        href: 'https://www.linkedin.com/in/vishaldhatrika/',
        target: '_blank',
        icon: 'tabler:brand-linkedin',
      },
      { text: 'See my work', href: '/#projects' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: '' }}
  >
    <Fragment slot="title">
      Hi, I'm <span class="text-accent dark:text-white"> Vishal</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        I <span class="font-semibold">solve</span> problems, <span class="font-semibold">create</span> digital experiences,
        and <span class="font-semibold">communicate</span> ideas across technology, design, and media.</span
      >
      <br /><br />
      <span class="block mb-1 sm:hidden font-bold text-blue-600">I solve, create & communicate.</span>
      Working at the intersection of technology, design, and communication - I turn complex problems into simple, usable
      experiences. I enjoy tackling complex problems, improving systems, and building digital experiences that are practical,
      engaging, and accessible. Whether the task involves coding, designing, writing, or troubleshooting, I bring creativity,
      technical expertise, and a focus on delivering results that matter.
    </Fragment>
  </Hero>

  <!-- Note Widget  -->

  <Note title="Motto:" description="Solve problems, communicate clearly, and build meaningful experiences." />

  <!-- added -->

  <Fragment slot="header">
    <Header
      links={[
        { text: 'Home', href: '/#' },
        { text: 'Projects', href: '/#projects' },
        { text: 'Testimonials', href: '/#testimonials' },
        { text: 'Blog', href: '/blog' },
        { text: 'GitHub', href: 'https://github.com/vishaldhatrika' },
      ]}
      actions={[
        {
          text: 'Hire me',
          href: '/about#contact',
        },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <Steps
    id="resume"
    title="Work experience"
    items={[
      {
        title:
          'Web Developer <br /> <span class="font-normal">YAAANA - The Yiddish Arts and Academics Association of North America</span> <br /> <span class="text-sm font-normal">2024 - Present</span>',
        description: `Developing and enhancing a WordPress site for 6,000+ Montly active users. <br /> Integrated Shopify and WooCommerce. <br /> Optimized mobile responsiveness with HTML, CSS, PHP. <br /> Focused on accessibility, SEO, and cultural initiatives.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'CS and Math Tutor <br /> <span class="font-normal">UMKC SI and Tutoring - International Center for Supplemental Instruction</span> <br /> <span class="text-sm font-normal">2024</span>',
        description: `Mentored 25+ students in CS and math. <br /> Boosted project completions and scores by 10 percent. <br /> Focused on debugging, React, and core programming concepts.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Pre-Education Programme Trainee <br /> <span class="font-normal">Epam Systems</span> <br /> <span class="text-sm font-normal">2020 - 2021</span>',
        description: `Worked on 11+ technical projects. <br /> Hands-on experience with Java, Maven, Git, and testing. <br /> Learned Agile workflows in a fast-paced environment.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Writing Consultant <br /> <span class="font-normal">UMKC Writing Studio</span> <br /> <span class="text-sm font-normal">2023 - 2024</span>',
        description: `Guided PhD students through dissertations. <br /> Helped undergraduates improve academic writing. <br /> Resulted in 10 percent improvement in grades.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Fitness Center Ops <br /> <span class="font-normal">UMKC Campus Recreation</span> <br /> <span class="text-sm font-normal">2023 - 2024</span>',
        description: `Managed safety, health compliance and equipment maintenance. <br /> Provided IT support and scripting solutions for device inventory. <br /> Ensured smooth operations and user safety.`,
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    id="resume"
    title="Education"
    items={[
      {
        title: `M.S. in Computer Science <br /> <span class="font-normal">University of Missouri - Kansas City</span> <br />`,
        // commented out from title content above  -  <span class="text-sm font-normal">2022 - 2024</span>
        icon: 'tabler:school',
      },
      {
        title: `B.Tech in Computer Science and Engineering <br /> <span class="font-normal">JNTU Hyderabad</span> <br /> `,
        // commented out from title content above  -  <span class="text-sm font-normal">2018 - 2022</span>
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Skills"
    subtitle="Explore my technical expertise that powers innovation and problem-solving."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: 'Software Engineering',
        description: 'Experienced in building scalable and maintainable applications.',
      },
      {
        title: 'Web Development',
        description: 'Frontend and backend expertise using React, Node.js, and .NET Core.',
      },
      {
        title: 'UI Design',
        description: 'Designing intuitive and responsive interfaces with user focus.',
      },
      {
        title: 'Data Science & Analytics',
        description: 'Leveraging Python, SQL, and ML models for insights and predictions.',
      },
      {
        title: 'Blockchain',
        description: 'Developing decentralized apps and secure blockchain solutions.',
      },
      {
        title: 'Cloud Platforms',
        description: 'Hands-on with AWS, Azure, and deployment pipelines.',
      },
      {
        title: 'Databases',
        description: 'Experience with SQL Server, MySQL, and efficient schema design.',
      },
      {
        title: 'Agile & DevOps',
        description: 'Skilled in Git, CI/CD, Azure DevOps, Docker, and REST APIs.',
      },
      {
        title: 'Problem Solving',
        description: 'Competitive programming and algorithm design experience.',
      },
    ]}
  />

  <!-- Content Widgets (Projects) **************** -->

  <!-- Product Landing Page -->
  <Content
    id="projects"
    title="Projects"
    subtitle="A selection of software, design, and research projects."
    isReversed
    items={[
      {
        title: 'Description:',
        description:
          'Responsive Product Landing Page built with React and TypeScript. Showcases clean architecture, reusable components, and fidelity to design specs.',
      },
      {
        title: 'Role:',
        description: 'Developed the UI from Figma design, ensuring modularity and responsiveness across breakpoints.',
      },
    ]}
    image={{
      src: '~/assets/images/p1-plp.png',
      alt: 'Product Landing Page',
    }}
    callToAction={{
      target: '_blank',
      text: 'View on GitHub',
      icon: 'tabler:chevron-right',
      href: 'https://github.com/vishaldhatrika/alter-tryout-vishaldhatrika',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-2xl">Responsive Product Landing Page</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- BlockCertify -->
  <Content
    id="blockcertify"
    title=""
    subtitle=""
    items={[
      {
        title: 'Description:',
        description:
          'Blockchain based certificate verification system using Ethereum and Solidity. Ensures secure, tamper proof validation of academic or professional credentials.',
      },
      {
        title: 'Role:',
        description: 'Developed Solidity smart contracts and integrated web3.js frontend for verification workflows.',
      },
    ]}
    image={{
      src: '~/assets/images/p2-blockcertify.png',
      alt: 'BlockCertify Blockchain Certificate Verification',
    }}
    callToAction={{
      target: '_blank',
      text: 'Details Page',
      icon: 'tabler:chevron-right',
      href: '/projects/blockcertify',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-2xl">BlockCertify - Blockchain Certificate Verification</span>
      </h3>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-green-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Meme-ory Game -->
  <Content
    id="meme-ory-game"
    title=""
    subtitle=""
    isReversed
    items={[
      {
        title: 'Description:',
        description:
          'A meme themed memory card game built with JavaScript, HTML, and CSS. Enhances interactivity while reinforcing DOM manipulation skills.',
      },
      {
        title: 'Role:',
        description: 'Designed the gameplay logic and implemented responsive styling with pure JavaScript.',
      },
    ]}
    image={{
      src: '~/assets/images/p3-memory.png',
      alt: 'Meme-ory Game',
    }}
    callToAction={{
      target: '_blank',
      text: 'Play the game now',
      icon: 'tabler:chevron-right',
      href: 'https://memorygame.vishaldhatrika.me/',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-2xl">Meme-ory Game</span>
      </h3>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-yellow-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Mills Nine Men’s Morris -->
  <Content
    id="nine-mens-morris"
    title=""
    subtitle=""
    items={[
      {
        title: 'Description:',
        description:
          'A digital version of the Nine Men’s Morris board game. Implements rules, strategy, and turn based mechanics using Java and C#.',
      },
      {
        title: 'Role:',
        description: 'Built the core game logic and UI interactions for player moves and win detection.',
      },
    ]}
    image={{
      src: '~/assets/images/p4-mills.png',
      alt: 'Nine Men’s Morris Game',
    }}
    callToAction={{
      target: '_blank',
      text: 'View on GitHub',
      icon: 'tabler:chevron-right',
      href: 'https://github.com/vishaldhatrika/Mills',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-2xl">Mills Nine Men’s Morris Game</span>
      </h3>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-purple-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Cuisine Haveli -->
  <Content
    id="cuisine-haveli"
    title=""
    subtitle=""
    isReversed
    items={[
      {
        title: 'Description:',
        description:
          'A restaurant web application built with PHP, MySQL, and Bootstrap. Includes menu browsing, reservations, and order management.',
      },
      {
        title: 'Role:',
        description: 'Developed backend logic in PHP and designed responsive layouts with Bootstrap.',
      },
    ]}
    image={{
      src: '~/assets/images/p5-cuisine.png',
      alt: 'Cuisine Haveli',
    }}
    callToAction={{
      target: '_blank',
      text: 'Visit the site',
      icon: 'tabler:chevron-right',
      href: 'https://cuisinehaveli.wuaze.com/',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-2xl">Cuisine Haveli</span>
      </h3>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-red-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Sales Analytics Prediction Model -->
  <Content
    id="sales-analytics"
    title=""
    subtitle=""
    items={[
      {
        title: 'Description:',
        description:
          'A machine learning model for predicting sales trends using Python and scikit-learn. Provides analytics and data visualization with Matplotlib.',
      },
      {
        title: 'Role:',
        description: 'Built regression models and data preprocessing pipelines for forecasting accuracy.',
      },
    ]}
    image={{
      src: '~/assets/images/p6-sales.png',
      alt: 'Sales Analytics Prediction Model',
    }}
    callToAction={{
      target: '_blank',
      text: 'View on GitHub',
      icon: 'tabler:chevron-right',
      href: 'https://github.com/vishaldhatrika/sales-forecasting-project-umkc-cs5530',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-2xl">Sales Analytics Prediction Model</span>
      </h3>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-teal-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    id="testimonials"
    title="Testimonials"
    subtitle="Feedback from peers, mentors, and students."
    testimonials={[
      {
        testimonial: `I struggled a lot with this course online, but Vishal gave me some helpful tips. I'll likely opt for in-person classes going forward.`,
        name: 'Student',
        job: 'UMKC',
        image: {
          src: 'https://images.unsplash.com/photo-1511367461989-f85a21fda167?q=80&w=3431&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
          alt: 'Person Image',
        },
      },
      {
        testimonial: `Vishal has advanced knowledge of multiple programming languages and has greatly influenced our students and campus life with his expertise and dedication.`,
        name: 'Supervisor',
        job: 'UMKC Academic Support and Mentoring',
        image: {
          src: 'https://images.unsplash.com/photo-1511367461989-f85a21fda167?q=80&w=3431&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
          alt: 'Person Image',
        },
      },
      {
        testimonial: `Vishal is my favorite student on project teams. He is silent, cool, and an effective leader and programmer.`,
        name: 'Professor',
        job: 'JNT University Hyd',
        image: {
          src: 'https://images.unsplash.com/photo-1511367461989-f85a21fda167?q=80&w=3431&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
          alt: 'Person Image',
        },
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Let's create together"
    subtitle="Ready to transform your vision into captivating designs?"
    actions={[
      {
        variant: 'primary',
        text: 'Hire me',
        href: '/about#form',
      },
    ]}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Read blog posts"
    information={`Stories and insights from building, learning, and growing in tech and creativity.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
