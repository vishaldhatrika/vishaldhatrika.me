---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import ContactUs from '~/components/widgets/Contact.astro';

const metadata = {
  title: 'About me',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About Me"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Coding workspace',
    }}
  >
    <Fragment slot="title">
      Hi, I am <span class="text-accent dark:text-white">Vishal Dhatrika</span>
    </Fragment>

    <Fragment slot="subtitle">
      I am a software engineer with experience in full stack development, technical writing, and UI design. I enjoy
      building clean, scalable solutions and helping others learn through documentation and teaching. My goal is to
      create meaningful products that are easy to use and well engineered.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Quick facts"
    stats={[
      { title: 'Years of Coding', amount: '7+' },
      { title: 'Patent Application', amount: '1' },
      { title: 'Published Paper', amount: '1' },
      { title: 'Cloud Certifications', amount: '2' },
      { title: 'Students mentored', amount: '25+' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="What I work on"
    subtitle="I focus on developing software and web solutions, designing user friendly interfaces, and writing clear documentation."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Full Stack Development',
        description: 'Building robust web applications using React, .NET Core, Node.js, SQL, and cloud platforms.',
        icon: 'tabler:code',
      },
      {
        title: 'UI and UX Design',
        description: 'Designing responsive, accessible, and visually appealing user interfaces with modern frameworks.',
        icon: 'tabler:palette',
      },
      {
        title: 'Technical Writing',
        description: 'Creating API documentation, guides, and tutorials to make technology easier to understand.',
        icon: 'tabler:book',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: 'Web Development',
        description: 'From landing pages to complex apps, I design and implement responsive and scalable websites.',
        icon: 'tabler:device-desktop',
      },
      {
        title: 'Problem Solving',
        description: 'I enjoy tackling coding challenges and creating optimized solutions with clean architecture.',
        icon: 'tabler:puzzle',
      },
      {
        title: 'Mentorship',
        description: 'Tutored students in computer science and math, helping them build confidence in coding.',
        icon: 'tabler:users',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'Creative coding image',
    }}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="My values"
    subtitle="The principles that guide my work and collaborations."
    items={[
      {
        title: 'Collaboration',
        description: 'I believe the best solutions come from teamwork and clear communication.',
      },
      {
        title: 'Continuous Learning',
        description: 'I strive to stay updated with evolving technologies and improve my skills every day.',
      },
      {
        title: 'Clarity',
        description: 'Whether coding or writing, I value simplicity and clarity for both users and developers.',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Highlights"
    subtitle="Some achievements I am proud of."
    isReversed={true}
    callToAction={{
      text: 'See projects',
      href: '/#projects',
    }}
    items={[
      {
        title: 'Published Portfolio Projects',
        description:
          'Built and deployed applications including blockchain certificate verification and a sales prediction model.',
        icon: 'tabler:code',
      },
      {
        title: 'Tutoring Experience',
        description: 'Worked as a tutor helping peers in React, C#, and problem solving.',
        icon: 'tabler:school',
      },
      {
        title: 'Technical Writing',
        description: 'Created API documentation and technical content used by developers and teams.',
        icon: 'tabler:file-description',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Where I have been"
    tagline="Education and Work"
    columns={4}
    items={[
      {
        title: 'UMKC',
        description: 'M.S. in Computer Science, 2024',
      },
      {
        title: 'JNTU Hyderabad',
        description: 'B.Tech in Computer Science, 2022',
      },
      {
        title: 'The Yiddish Arts and Academics Association of North America',
        description: 'Web Developer, 2024 - Present',
      },
      {
        title: 'Epam Systems',
        description: 'Trainee, 2020 - 2021',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    id="contact"
    title="Get in touch"
    tagline="Contact me"
    columns={2}
    items={[
      {
        title: 'Email',
        description: 'vd@vishaldhatrika.me',
        icon: 'tabler:mail',
      },
      {
        title: 'LinkedIn',
        description: '@VishalDhatrika',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  />

  <ContactUs
    id="form"
    title="Drop me a message!"
    subtitle="I am always open to freelance work, collaborations, or just a friendly hello."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
    }}
    disclaimer={{
      label:
        'By submitting this form you agree to the storage of your personal information for communication purposes.',
    }}
    description="I usually respond within 24 hours."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Other ways to connect"
    items={[
      {
        title: 'GitHub',
        description: '@vishaldhatrika',
        icon: 'tabler:brand-github',
      },
      {
        title: 'Portfolio',
        description: 'https://vishaldhatrika.me',
        icon: 'tabler:world',
      },
    ]}
  />
</Layout>
