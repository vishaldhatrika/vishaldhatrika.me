---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import type { CallToAction as Props } from '~/types';

const {
  variant = 'secondary',
  target,
  text = Astro.slots.render('default'),
  icon = '',
  class: className = '',
  type,
  ...rest
} = Astro.props;

const variants = {
  primary: 'btn-primary relative group overflow-hidden',
  secondary: 'btn-secondary relative group overflow-hidden',
  tertiary: 'btn btn-tertiary relative group overflow-hidden',
  link: 'cursor-pointer hover:text-primary',
};
---

{
  type === 'button' || type === 'submit' || type === 'reset' ? (
    <button type={type} class={twMerge(variants[variant] || '', className)} {...rest}>
      {/* Glow layer */}
      <span class="absolute inset-0 [background:radial-gradient(circle_at_var(--x)_var(--y),#00d1ffaa,transparent_90%)] opacity-0 group-hover:opacity-100 transition duration-200" />

      {/* Content */}
      <span class="relative z-10 group-hover:background-opacity-50">
        <Fragment set:html={text} />
        {icon && <Icon name={icon} class="w-5 h-5 ml-1 -mr-1.5 rtl:mr-1 rtl:-ml-1.5 inline-block" />}
      </span>
    </button>
  ) : (
    <a
      class={twMerge(variants[variant] || '', className)}
      {...(target ? { target: target, rel: 'noopener noreferrer' } : {})}
      {...rest}
    >
      <span class="absolute inset-0 [background:radial-gradient(circle_at_var(--x)_var(--y),#00d1ffaa,transparent_90%)] opacity-0 group-hover:opacity-100 transition duration-200" />

      <span class="relative z-10 group-hover:background-opacity-50">
        <Fragment set:html={text} />
        {icon && <Icon name={icon} class="w-5 h-5 ml-1 -mr-1.5 rtl:mr-1 rtl:-ml-1.5 inline-block" />}
      </span>
    </a>
  )
}
