{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
,
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "blog.vishaldhatrika.me" }
      ],
      "destination": "https://vishaldhatrika.me/blog",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "cuisinehaveli.vishaldhatrika.me" }
      ],
      "destination": "https://vishaldhatrika.me/projects/cuisinehaveli",
      "permanent": true
    }
  ]
}
